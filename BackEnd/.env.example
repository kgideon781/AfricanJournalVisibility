# =============================================================================
# AJV backend runtime config template. Copy to .env and fill in real values.
# .env is git-ignored (never commit real secrets); .env.example is committed.
# =============================================================================

# --- Django ---
# Generate with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
DJANGO_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_50_CHAR_STRING
DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1 your.domain.example

# --- Postgres (used both by the pgdb container's init AND Django DATABASES) ---
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=pgdb
POSTGRES_PORT=5432

# --- RabbitMQ (used both by rabbitmq init AND Celery URLs below) ---
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=CHANGE_ME

# --- Celery ---
# Broker URL must match RABBITMQ_DEFAULT_USER/PASS above.
CELERY_BROKER=amqp://guest:CHANGE_ME@rabbitmq:5672//
CELERY_BACKEND=rpc://

# --- pgAdmin ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME
